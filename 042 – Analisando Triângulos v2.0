{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPDkDIvuwTIIqbw5myFWC3V"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"K3VsyX0aMFv3"},"outputs":[],"source":[]},{"cell_type":"markdown","source":["Refaça o DESAFIO 35 dos triângulos, acrescentando o recurso de mostrar que tipo de triângulo será formado:\n","\n","– EQUILÁTERO: todos os lados iguais\n","\n","– ISÓSCELES: dois lados iguais, um diferente\n","\n","– ESCALENO: todos os lados diferentes"],"metadata":{"id":"LlZJFNm1MjKk"}},{"cell_type":"code","source":["a = float(input('Digite o valor da primeira reta: '))\n","b = float(input('Digite o valor da segunda reta: '))\n","c = float(input('Digite o valor da terceira reta: '))\n","\n","if a < b + c and b < a + c and c < a + b:\n","    print('As retas podem formar um triângulo')\n","    if a == b and b == c:\n","        print('O triângulo formado é equilátero')\n","    elif a == b or a == c or b == c:\n","        print('O triângulo formado é isósceles')\n","    else:\n","        print('O triângulo formado é escaleno')\n","else:\n","    print('As retas não podem formar um triângulo')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"siGe8BN3MkNB","executionInfo":{"status":"ok","timestamp":1785283850766,"user_tz":180,"elapsed":4499,"user":{"displayName":"Bruno Vitorino","userId":"10062252203588710975"}},"outputId":"91d90f5e-07cf-4254-90e9-55f7c3cc37cb"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Digite o valor da primeira reta: 5\n","Digite o valor da segunda reta: 6\n","Digite o valor da terceira reta: 5\n","As retas podem formar um triângulo\n","O triângulo formado é isósceles\n"]}]}]}