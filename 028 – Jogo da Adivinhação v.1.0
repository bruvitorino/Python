{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMUgtcuYaPmdV1sY7QKt6Wv"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"9LvmBYRUuf4C"},"outputs":[],"source":[]},{"cell_type":"markdown","source":["Escreva um programa que faça o computador “pensar” em um número inteiro entre 0 e 5 e peça para o usuário tentar descobrir qual foi o número escolhido pelo computador. O programa deverá escrever na tela se o usuário venceu ou perdeu."],"metadata":{"id":"iPquhXa5ujvl"}},{"cell_type":"code","source":["import random\n","\n","n = int(input('Digite um número de 0 a 5: '))\n","sorteado = random.randint(0, 5)\n","if n == sorteado:\n","  print('Você venceu!')\n","else:\n","  print('Você perdeu!')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"XeELCdziukYs","executionInfo":{"status":"ok","timestamp":1785192172528,"user_tz":180,"elapsed":10082,"user":{"displayName":"Bruno Vitorino","userId":"10062252203588710975"}},"outputId":"05ab277f-0e93-45ef-a643-ff89d3db767f"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Digite um número de 0 a 5: 5\n","Você perdeu\n"]}]}]}